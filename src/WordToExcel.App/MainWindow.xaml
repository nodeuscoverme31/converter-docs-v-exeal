<Window x:Class="WordToExcel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Word → Excel"
        Width="820"
        Height="610"
        MinWidth="560"
        MinHeight="470"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,22">
        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="Word → Excel" />
        <TextBlock Margin="0,7,0,0"
                   FontSize="14"
                   Foreground="{StaticResource AppMutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="Преобразуйте один документ Word в рабочий Excel-файл. Таблицы попадут на отдельные листы, обычный текст — в лист «Контекст»." />
      </StackPanel>

      <Border x:Name="DropZoneBorder"
              Grid.Row="1"
              Style="{StaticResource CardStyle}"
              MinHeight="168"
              BorderThickness="1.5"
              AllowDrop="True"
              DragOver="DropZone_DragOver"
              DragLeave="DropZone_DragLeave"
              Drop="DropZone_Drop"
              automation:AutomationProperties.Name="Область выбора документа Word">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Path Grid.Row="0"
                Width="34"
                Height="34"
                HorizontalAlignment="Center"
                Data="{StaticResource DocumentIconGeometry}"
                Stretch="Uniform"
                Stroke="{StaticResource AppAccentBrush}"
                StrokeThickness="1.7"
                StrokeLineJoin="Round" />

          <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="DropTitleText"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="Перетащите сюда файл .doc или .docx" />
            <TextBlock Margin="0,5,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       Text="или выберите документ вручную" />
          </StackPanel>

          <Button x:Name="ChooseFileButton"
                  Grid.Row="2"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Center"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Click="ChooseFileButton_Click"
                  automation:AutomationProperties.Name="Выбрать документ Word">
            <TextBlock Text="Выбрать файл" />
          </Button>
        </Grid>
      </Border>

      <StackPanel Grid.Row="2" Margin="0,16,0,0">
        <Border x:Name="SelectedFileCard"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0"
                  Width="24"
                  Height="24"
                  Margin="0,2,14,0"
                  Data="{StaticResource DocumentIconGeometry}"
                  Stretch="Uniform"
                  Stroke="{StaticResource AppAccentBrush}"
                  StrokeThickness="1.6"
                  StrokeLineJoin="Round" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="Выбранный файл"
                         FontSize="12"
                         Foreground="{StaticResource AppMutedTextBrush}" />
              <TextBlock x:Name="SelectedFileNameText"
                         Margin="0,3,0,0"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="SelectedFilePathText"
                         Margin="0,3,0,0"
                         FontSize="12"
                         Foreground="{StaticResource AppMutedTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <Button x:Name="ConvertButton"
                Margin="0,14,0,0"
                HorizontalAlignment="Stretch"
                Style="{StaticResource PrimaryButtonStyle}"
                IsDefault="True"
                IsEnabled="False"
                Click="ConvertButton_Click"
                automation:AutomationProperties.Name="Преобразовать выбранный документ в Excel">
          <TextBlock Text="Преобразовать в Excel" />
        </Button>

        <StackPanel x:Name="ProcessingPanel"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
          <ProgressBar Height="5"
                       IsIndeterminate="True" />
          <TextBlock Margin="0,8,0,0"
                     HorizontalAlignment="Center"
                     Foreground="{StaticResource AppMutedTextBrush}"
                     Text="Преобразуем документ…" />
        </StackPanel>
      </StackPanel>

      <Border x:Name="ResultCard"
              Grid.Row="3"
              Margin="0,16,0,0"
              Style="{StaticResource CardStyle}"
              Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Path x:Name="ResultIcon"
                Grid.Column="0"
                Width="26"
                Height="26"
                Margin="0,1,14,0"
                Data="{StaticResource SuccessIconGeometry}"
                Stretch="Uniform"
                Stroke="{StaticResource AppSuccessBrush}"
                StrokeThickness="2.2"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round" />

          <StackPanel Grid.Column="1">
            <TextBlock x:Name="ResultTitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Готово" />
            <TextBlock x:Name="ResultMessageText"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ResultPathText"
                       Margin="0,9,0,0"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <WrapPanel Margin="0,15,0,0">
              <Button x:Name="OpenFolderButton"
                      Margin="0,0,10,8"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Click="OpenFolderButton_Click"
                      automation:AutomationProperties.Name="Открыть папку с результатом">
                <StackPanel Orientation="Horizontal">
                  <Path Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        Data="{StaticResource FolderIconGeometry}"
                        Stretch="Uniform"
                        Stroke="{StaticResource AppAccentBrush}"
                        StrokeThickness="1.5"
                        StrokeLineJoin="Round" />
                  <TextBlock VerticalAlignment="Center" Text="Открыть папку" />
                </StackPanel>
              </Button>

              <Button x:Name="ResetButton"
                      Margin="0,0,0,8"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Click="ResetButton_Click"
                      automation:AutomationProperties.Name="Преобразовать другой файл">
                <StackPanel Orientation="Horizontal">
                  <Path Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        Data="{StaticResource ResetIconGeometry}"
                        Stretch="Uniform"
                        Stroke="{StaticResource AppAccentBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                  <TextBlock VerticalAlignment="Center" Text="Преобразовать другой файл" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</Window>
